# Ignorar todo excepto frontend y backend
*

# Incluir frontend, backend y README
!frontend/
!backend/
!README.md

# Dentro del frontend, ignorar archivos innecesarios
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.DS_Store
frontend/coverage/
frontend/.pnp
frontend/.pnp.js
frontend/.eslintcache

# Dentro del backend, ignorar archivos innecesarios
backend/node_modules/
backend/build/
backend/dist/
backend/.env
backend/.env.local
backend/.env.development.local
backend/.env.test.local
backend/.env.production.local
backend/npm-debug.log*
backend/yarn-debug.log*
backend/yarn-error.log*
backend/.DS_Store
backend/coverage/
backend/*.tsbuildinfo
